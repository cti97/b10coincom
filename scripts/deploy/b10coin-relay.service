# b10coin RELAY unit — deploy this on the VPS only. The node units
# (b10coin.service) go on the Raspberry Pis and dial THIS machine outbound.
#
# Assumes the machine already has (see scripts/deploy/README.md §§2, 6):
#   - the binary at /opt/b10coin/b10coin-relay    (from scripts/deploy/build.sh, scp'd)
#   - a system user and group "b10coin"
#   - TCP port 7001 reachable ONLY from the validators: a cloud/security-group
#     rule restricting the port plus, if a host firewall is in use, one ufw
#     ALLOWLIST line per validator IP (§4) — NEVER `ufw allow 7001/tcp`, which
#     opens the relay to the whole internet
#
# The relay persists nothing and reads no config; everything in /opt is read
# as a static binary, so ProtectSystem=strict is exact, not aspirational.
#
# MemoryMax is the audit's N-2 ceiling for the one component a stranger can
# reach, and its number is DERIVED from the relay's own defaults, not guessed:
# one CONNECTION holds at most (write-queue-bytes + write-queue-frames x 32 B
# + 2 x max-frame-bytes) = 2 MiB of queued payload + 4096 x 32 B = 128 KiB of
# queue entry ring + the 1 MiB frame in the writer's hand + the 1 MiB frame in
# the reader's hand = 4.125 MiB, and there are MaxConns=32 of them, so the pin
# is 32 x 4.125 MiB = 132 MiB (relay.Options.MaxPinnedBytes computes exactly
# this; any change to a relay default must move that number AND this unit).
# The per-frame entry ring term is the one the previous revision of this
# comment omitted: a byte budget of 2 MiB admits ~2 million one-byte frames,
# ~64 MiB of entries per connection, which is how 8 connections from one IP
# measured 231.6 MiB and the full registry over 1 GiB against a 128 MiB claim.
# 256M buys the 132 MiB worst case plus the Go runtime's own heap/goroutine
# overhead with clear headroom; if the bound ever lies, systemd kills this
# process instead of the host dying, and Restart=always brings the relay
# back (validators redial through their own backoff).

[Unit]
Description=b10coin relay (dumb frame forwarder for the home validators)
# The relay binds a public port at startup; same network-online rationale as
# the node unit.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=b10coin
Group=b10coin
WorkingDirectory=/opt/b10coin
# The listen address. ":7001" is also the binary's own default; it is spelled
# out here so the port the Pis dial and the port the relay binds are visibly
# the same decision, in the same file. (NOTE: the relay's flag is --addr, not
# --listen — --listen is the node command's optional direct-peer listener.)
Environment=B10COIN_RELAY_ADDR=:7001

ExecStart=/opt/b10coin/b10coin-relay --addr ${B10COIN_RELAY_ADDR}

Restart=always
RestartSec=5

# The relay stores nothing anywhere: strict read-only filesystem, no home,
# no temp files of its own beyond PrivateTmp's private scratch.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# 32 conns x (2 MiB queue payload + 4096 x 32 B entry ring + 2 x 1 MiB in the
# writer's/reader's hands) = 132 MiB of pin at the relay's defaults, derived
# above; 256M is that plus the Go runtime with headroom.
MemoryMax=256M

[Install]
WantedBy=multi-user.target
