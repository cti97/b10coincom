# b10coin validator NODE unit — deploy this on each RASPBERRY PI, not on the
# VPS. The relay unit (b10coin-relay.service) goes on the VPS.
#
# Assumes the machine already has (see scripts/deploy/README.md §§2, 3, 6):
#   - the binary at /opt/b10coin/b10coin          (from scripts/deploy/build.sh, scp'd)
#   - a system user and group "b10coin"
#   - internet access OUTBOUND to the relay's TCP port 7001 (no port
#     forwarding, no inbound rule: every connection a node makes is outbound)
#   - /var/lib/b10coin created and owned by b10coin.b10coin, via StateDirectory
#   - the SHARED committee file at /var/lib/b10coin/committee.json (§3.2:
#     identical bytes on every Pi) and THIS machine's key file at
#     /var/lib/b10coin/b10coin.key (§3.1: generated ON the Pi, mode 0600)
#
# DANGER: NEVER copy b10coin.key between two Pis. Two machines holding one
# key file are two machines acting as ONE validator — the same seat in the
# shared committee file — and the committee stops finalizing. Each Pi runs
# `b10coin keygen` itself and contributes only its PRINTED PUBLIC key to the
# committee file.

[Unit]
Description=b10coin validator node (three-Pi testnet member)
# network-online (not just network.target): the node dials the relay at
# startup, and starting before the Pi has an address would only add a redial
# delay to the very first boot.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=b10coin
Group=b10coin
WorkingDirectory=/var/lib/b10coin
StateDirectory=b10coin

# Everything a deployment edits lives here. Edit BEFORE the first enable:
# B10COIN_RELAY to the VPS's public address (same on every Pi);
# B10COIN_GENESIS is the shared committee file (byte-identical on every Pi);
# B10COIN_KEY is THIS machine's key file (unique per Pi).
Environment=B10COIN_DATA=/var/lib/b10coin
Environment=B10COIN_HTTP=127.0.0.1:8645
Environment=B10COIN_RELAY=changeme.example.com:7001
Environment=B10COIN_GENESIS=/var/lib/b10coin/committee.json
Environment=B10COIN_KEY=/var/lib/b10coin/b10coin.key

# The node's seat is derived from where its key's public half sits in the
# committee file; a key that is not listed there REFUSES to start rather
# than signing for a seat it does not hold (audit A-1's refusal rule).
ExecStart=/opt/b10coin/b10coin node \
    --dir ${B10COIN_DATA} \
    --http ${B10COIN_HTTP} \
    --relay ${B10COIN_RELAY} \
    --genesis ${B10COIN_GENESIS} \
    --key ${B10COIN_KEY}

Restart=always
RestartSec=5

# A validator holds a real private key; run it with the smallest practical
# sandbox. The chain and key file write only under /var/lib/b10coin
# (ReadWritePaths pairs with ProtectSystem=strict), RPC stays on
# 127.0.0.1:8645 by default, and a 0600 key under a 0750 StateDirectory is
# readable only by the b10coin user.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/b10coin

[Install]
WantedBy=multi-user.target