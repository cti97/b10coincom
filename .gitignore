# Secrets and keys — NEVER commit these.
# A validator private key in git history means a permanently compromised validator.
.env
.env.*
*.key
*.pem
keys/
secrets/
genesis/private/
validator-keys/

# Build output
/bin/
/dist/
/build/
*.exe

# scripts/build-release.sh's staging directory. Ignored for a reason beyond
# tidiness (audit S-10): the release stamps `vcs.modified` from `git status`,
# so an untracked staging directory inside the tree would make every artifact
# claim the tree was dirty — a false alarm that would teach operators to
# ignore the one field meant to stop a mixed-build committee from forking.
/.release-stage/

# Local devnet / testnet data (regenerable, never authoritative)
/devnet-data/
/testnet-data/
/data/

# Test artifacts
*.log
*.prof
coverage.out

# Editor / OS
.DS_Store
.idea/
.vscode/

# SDD controller scratch: ledger, task briefs, reports and build caches.
.superpowers/

# Node data directory created by `b10coin node` (regenerable).
/b10coin-data/

# The walkthrough's default WORK directory (docs/2026-11-01-m6-walkthrough.md):
# keys, chain data and a pid file, all regenerable, none of it tracked.
/walkthrough/
